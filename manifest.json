{
  "manifest_version": 3,
  "name": "YTPlay",
  "description": "Keyboard shortcuts & voice search for YouTube Music. Arrow keys to seek/skip/volume, M for mic.",
  "version": "3.0.0",
  "permissions": [],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
